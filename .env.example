# Copy to .env.local and fill in. Every variable here must also exist in the
# Vercel project settings for production and preview.

# --- Supabase ---------------------------------------------------------------
# Project URL and anon key. Safe to expose: the anon key is constrained by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Bypasses RLS entirely — server-side only, never import it
# into a client component and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- On-demand revalidation -------------------------------------------------
# Shared secret for POST /api/revalidate.
REVALIDATE_SECRET=

# --- Reviews ----------------------------------------------------------------
# Salt for hashing submitter IPs before they are stored (SHA-256 over
# "<salt>:<ip>"). Raw IPs are never written to the database, and without a salt
# the small IPv4 space would be trivially brute-forceable from the hashes.
#
# Required. If unset, POST /api/reviews fails closed with 503 rather than
# accepting unlimited unrate-limited submissions.
#
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Changing it resets every rate-limit bucket and orphans existing ip_hash
# values, so treat it as a long-lived secret.
REVIEW_IP_SALT=
