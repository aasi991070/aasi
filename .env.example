# Copy to .env.local and fill in. Every variable here must also exist in the
# Vercel project settings for production and preview.

# --- Site ---------------------------------------------------------------------
# Canonical public origin, no trailing slash. Used as `metadataBase`, so every
# Open Graph image, canonical URL and (later) sitemap entry is built from it.
# Falls back to http://localhost:3000 when unset, which is fine locally and
# wrong everywhere else.
NEXT_PUBLIC_SITE_URL=https://<your-domain>

# --- Supabase ---------------------------------------------------------------
# Project URL and anon key. Safe to expose: the anon key is constrained by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Bypasses RLS entirely — server-side only, never import it
# into a client component and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Database password for `npm run db:migrate` (Session pooler string from
# Supabase Dashboard → Connect). Not used by the Next.js app at runtime.
SUPABASE_DB_PASSWORD=

# --- On-demand revalidation -------------------------------------------------
# Shared secret for POST /api/revalidate.
REVALIDATE_SECRET=

# --- Reviews ----------------------------------------------------------------
# Salt for hashing submitter IPs before they are stored (SHA-256 over
# "<salt>:<ip>"). Raw IPs are never written to the database, and without a salt
# the small IPv4 space would be trivially brute-forceable from the hashes.
#
# Required. If unset, POST /api/reviews fails closed with 503 rather than
# accepting unlimited unrate-limited submissions.
#
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Changing it resets every rate-limit bucket and orphans existing ip_hash
# values, so treat it as a long-lived secret.
REVIEW_IP_SALT=

# --- Razorpay (prompt 26) ---------------------------------------------------
# Server credentials — never expose RAZORPAY_KEY_SECRET to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Email (prompt 27c) -----------------------------------------------------
# Resend API key and verified sender (e.g. "Aasi <orders@yourdomain.com>").
RESEND_API_KEY=
ORDER_FROM_EMAIL=

# Vercel Cron auth for /api/cron/review-requests (daily review-request emails).
CRON_SECRET=

# --- Monitoring (prompt 28b) -----------------------------------------------
# Optional locally. Required in production for error alerts.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
