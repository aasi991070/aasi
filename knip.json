{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "app/**/{page,layout,loading,error,not-found,route,default,opengraph-image}.{ts,tsx}",
    "instrumentation.ts",
    "sentry.client.config.ts",
    "sentry.server.config.ts",
    "sentry.edge.config.ts",
    "vitest.config.mts",
    "playwright.config.ts",
    "tests/**/*.ts"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "hooks/**/*.{ts,tsx}",
    "constants/**/*.{ts,tsx}",
    "types/**/*.{ts,tsx}"
  ],
  "ignore": [
    "components/ui/**",
    "lib/utils.ts",
    "types/database.ts",
    "components/shared/LoadingSpinner.tsx"
  ],
  "ignoreBinaries": ["supabase"],
  "ignoreDependencies": ["tailwindcss", "postcss-load-config"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "exports": "off",
    "types": "off"
  }
}
