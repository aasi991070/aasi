{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "plugins": ["unused-imports"],
  "rules": {
    "unused-imports/no-unused-imports": "error",
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@/lib/supabase/client",
            "message": "Browser Supabase client is for auth and storage uploads only. Use lib/queries and server actions."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "app/admin/login/login-client.tsx",
        "components/storefront/account/AccountSignInClient.tsx",
        "lib/storage/images.ts"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
